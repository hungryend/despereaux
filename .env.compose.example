# Optional .env file for docker-compose variable substitution.
# Copy to .env (in this directory) and edit. Compose auto-loads it.
#
# Note: this file feeds COMPOSE variable substitution (the ${VAR:-default}
# bits in docker-compose.yml). The values inside the container are then set
# from those substitutions. The `.env.example` in this folder is the
# despereaux APP env (used when running uvicorn locally with `uv run`).

# Solo / development: true (auto-creates devuser, no Authentik needed).
# Production behind SWAG + Authentik: false.
DESPEREAUX_DEV_MODE=true

# Shared secret for the chaptarr / external import webhook.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DESPEREAUX_WEBHOOK_TOKEN=

# Optional — raises Google Books API rate cap.
GOOGLE_BOOKS_API_KEY=
