# Library + data
DESPEREAUX_LIBRARY_PATH=/ebooks
DESPEREAUX_DATA_DIR=/config
DESPEREAUX_DB_URL=sqlite+aiosqlite:////config/despereaux.db

# Auth
DESPEREAUX_DEV_MODE=false
DESPEREAUX_ADMIN_GROUP=ebook-admin

# Sync webhook (chaptarr / Readarr-style "Custom Script" callers).
# If unset, /api/admin/sync returns 503 and the watcher is the only auto-ingest path.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DESPEREAUX_WEBHOOK_TOKEN=

# Metadata enrichment (Phase 2)
DESPEREAUX_GOOGLE_BOOKS_API_KEY=

# Logging
DESPEREAUX_LOG_LEVEL=INFO
